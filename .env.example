# Server Configuration
PORT=8085
BASE_URL=http://localhost:8085

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sendly
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_DB=sendly

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Storage Configuration
DATA_DIR=/data
# DATA_DIR and CHUNK_DIR are claimed by this instance's database through a
# .sendly-instance marker file; the server refuses to start on storage owned
# by another database. Set to true once to claim existing, unmarked storage.
SENDLY_ADOPT_DATA_DIR=false

# Proxy Configuration
# Set to true if running behind Cloudflare: CF-Connecting-IP is then used as
# the client IP, but only on requests arriving from a TRUSTED_PROXIES peer.
BEHIND_CLOUDFLARE=false
# Comma-separated IPs/CIDRs of proxies allowed to set forwarding headers
# (X-Forwarded-For, X-Real-IP, CF-Connecting-IP). Empty = trust no proxy and
# use the direct peer address, except that BEHIND_CLOUDFLARE=true defaults
# this to Cloudflare's published edge ranges. If traffic reaches the app via
# cloudflared or a local reverse proxy, list that proxy's address here.
TRUSTED_PROXIES=

# File Limits
# Maximum file size in bytes (default: 750MB = 786432000)
MAX_FILE_SIZE=786432000

# Report Configuration
# Number of reports before automatic deletion (default: 3)
AUTO_DELETE_REPORT_COUNT=3

# Discord Webhook (optional)
# Leave empty to disable Discord notifications
DISCORD_WEBHOOK_URL=

# Gin Mode (debug or release)
GIN_MODE=debug

# CNS Auth integration (optional - omit to run without auth tiers)
# User-facing accounts surface: /api/me, /api/account/me, /api/auth/token/refresh
CNS_AUTH_URL=https://accounts.cns-studios.com
CNS_AUTH_CLIENT_ID=
CNS_AUTH_DESKTOP_CLIENT_ID=dropzone
CNS_AUTH_SERVICE_KEY=
# CNS's service-to-service API gateway: GET /api/service/me,
# /api/data/{service}/*. This is a DIFFERENT host from CNS_AUTH_URL above.
CNS_SERVICE_API_URL=https://api.cns-studios.com
# Slug this service is registered under with CNS; used as the {service}
# path segment for CNS's per-service KV store (/api/data/{service}/)
CNS_SERVICE_SLUG=sendly
# Max file size for authenticated users (default 1.5 GB)
AUTH_MAX_FILE_SIZE=1610612736

# Rate limits per route (per user when signed in, per client IP otherwise).
# 0 blocks every request on that limiter.
RATE_LIMIT_MAX_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STRICT_MAX_PER_MINUTE=15
RATE_LIMIT_STRICT_WINDOW_SECONDS=60
RATE_LIMIT_DOWNLOAD_MAX_PER_MINUTE=60
RATE_LIMIT_DOWNLOAD_WINDOW_SECONDS=60

# Migrations directory
MIGRATIONS_DIR=db/migrations

# Local CNS user cache (see internal/services/user_cache.go)
# How long a cached profile is trusted before re-syncing with CNS (hours)
USER_CACHE_TTL_HOURS=24
# How often the reconciliation job runs (minutes)
USER_CACHE_RECONCILE_INTERVAL_MINUTES=60
# How long a user can go unsynced before being marked inactive locally (days)
USER_CACHE_STALE_AFTER_DAYS=30

# Data retention in days (cleanup cycle hard-deletes rows past these; 0 disables)
FILE_RECORD_RETENTION_DAYS=30
UPLOAD_IP_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=90
TUNNEL_REJECTION_RETENTION_DAYS=30
